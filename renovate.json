{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am"
    ]
  },
  "packageRules": [
    {
      "description": "web/ is deployed on Vercel; its engines.node pins the Vercel build runtime and may only move to a Node major Vercel supports. Bump it by hand.",
      "matchFileNames": [
        "web/package.json"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchPackageNames": [
        "node"
      ],
      "enabled": false
    }
  ]
}
